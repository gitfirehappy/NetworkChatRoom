{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug x64",
            "type": "shell",
            "command": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "NetworkChatRoom.vcxproj",
                "/t:Build",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build Release x64",
            "type": "shell",
            "command": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "NetworkChatRoom.vcxproj",
                "/t:Build",
                "/p:Configuration=Release",
                "/p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Rebuild Debug x64",
            "type": "shell",
            "command": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "NetworkChatRoom.vcxproj",
                "/t:Rebuild",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean Debug x64",
            "type": "shell",
            "command": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "NetworkChatRoom.vcxproj",
                "/t:Clean",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}